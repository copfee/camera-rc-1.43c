# Shared by firmware and the native UI preview. Add new styles here.
if(RC_SHUTTER_STYLE STREQUAL "model")
    set(RC_SHUTTER_PREFIX "shutter_model")
elseif(RC_SHUTTER_STYLE STREQUAL "dragon")
    set(RC_SHUTTER_PREFIX "shutter")
else()
    message(FATAL_ERROR "Unknown shutter style: ${RC_SHUTTER_STYLE}")
endif()
set(RC_SHUTTER_SOURCES)
set(RC_SHUTTER_DEFINITIONS)
foreach(state idle pressed idle_full pressed_full)
    list(APPEND RC_SHUTTER_SOURCES "${CMAKE_CURRENT_LIST_DIR}/../../components/ui/src/${RC_SHUTTER_PREFIX}_${state}.c")
    string(TOUPPER "${state}" upper_state)
    list(APPEND RC_SHUTTER_DEFINITIONS "RC_SHUTTER_${upper_state}=rc_${RC_SHUTTER_PREFIX}_${state}")
endforeach()
